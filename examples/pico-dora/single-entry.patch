@@ -0,0 +1,97 @@
+# Set OPENARM_CLASSIC_PROFILE and OPENARM_HEAD_CAMERA before running from the project root.
+nodes:
+- id: webxr
+  path: dora-openarm-webxr
+  args: --pose-timeout 0.25
+  env:
+    TLS_CERTIFICATE_FILE: certs/server.crt
+    TLS_KEY_FILE: certs/server.key
+    VIEW_CONFIGURATION_FILE: view-webxr.yaml
+    WEBXR_ARM_SESSION_EVENTS: '1'
+  inputs:
+    tick: dora/timer/millis/4
+    camera_head_left:
+      source: head/image
+      queue_size: 1
+    camera_head_right:
+      source: head/image
+      queue_size: 1
+  outputs:
+  - pose_right
+  - trigger_right
+  - pose_left
+  - trigger_left
+  - grip_right
+  - grip_left
+  - joystick_x_right
+  - joystick_y_right
+  - joystick_x_left
+  - joystick_y_left
+  - button_a
+  - button_b
+  - button_x
+  - button_y
+  - status
+  - vr_receive_times
+  - pose_reference
+- id: state-merge
+  path: nodes/dora-openarm-state-merge/run.sh
+  inputs:
+    right: right/state
+    left: left/state
+  outputs:
+  - position
+- id: ik
+  path: dora-openarm-ik
+  args: --mode bimanual --tick-hz 250 --xml .venv/share/openarm_mujoco/v2/pedestal/pedestal.xml
+    --max-iters 5 --damping 0.1 --posture-cost 0 --lm-damping 0.01 --limit-velocity
+  inputs:
+    target_right: webxr/pose_right
+    target_left: webxr/pose_left
+    trigger_right: webxr/trigger_right
+    trigger_left: webxr/trigger_left
+    grip_right: webxr/grip_right
+    grip_left: webxr/grip_left
+    joystick_y_right: webxr/joystick_y_right
+    joystick_y_left: webxr/joystick_y_left
+    pose_reference: webxr/pose_reference
+    position: state-merge/position
+  outputs:
+  - position_right
+  - position_left
+  - status
+- id: right
+  path: nodes/dora-openarm-classic/run.sh
+  args: --side right --profile ${OPENARM_CLASSIC_PROFILE} --start-enabled --start-envelope
+    0 --period 0.05 --align-step 0.1 --allow-unreadable-mode --start-on-webxr
+  inputs:
+    move_position: ik/position_right
+    watchdog: dora/timer/millis/100
+    monitor: dora/timer/millis/500
+    webxr_session: webxr/status
+    request_state: ik/position_right
+  outputs:
+  - state
+  - status
+- id: left
+  path: nodes/dora-openarm-classic/run.sh
+  args: --side left --profile ${OPENARM_CLASSIC_PROFILE}
+  inputs:
+    move_position: ik/position_left
+    watchdog: dora/timer/millis/100
+    monitor: dora/timer/millis/500
+  outputs:
+  - state
+  - status
+- id: head
+  path: opencv-video-capture
+  env:
+    CAPTURE_PATH: ${OPENARM_HEAD_CAMERA}
+    ENCODING: jpeg
+    IMAGE_HEIGHT: 720
+    IMAGE_WIDTH: 1280
+    JPEG_QUALITY: 90
+  inputs:
+    tick: dora/timer/millis/33
+  outputs:
+  - image
